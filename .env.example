# Neon Postgres — connection string pooled (pgBouncer), usada pelo app
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"

# Neon Postgres — conexão direta, usada pelas migrações do Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Modo demonstração — deixa o app só-leitura (deploy público de portfólio).
# Só o valor "true" ativa; ausente ou qualquer outro valor = comportamento normal.
# MODO_DEMO="true"

# Sessão EM_ANDAMENTO de exemplo pra onde "Iniciar treino" leva em modo demo
# (criada pelo `npm run db:seed`, com id fixo). Só tem efeito com MODO_DEMO="true";
# sem ela, o botão some e a action recusa, como antes.
# DEMO_SESSAO_ID="demo-sessao-exemplo"

# Trava do seed de demonstração (prisma/seed.ts): ele APAGA TUDO antes de popular,
# então só roda com esta env em "true". Nunca defina no ambiente de produção.
# SEED_DEMO="true"

# Segredo do cron de re-seed diário (/api/reseed, agendado em vercel.json). A Vercel
# manda o header `Authorization: Bearer $CRON_SECRET` nas chamadas do cron; a rota
# recusa com 401 se não bater — e também se esta env não estiver definida.
# Só tem efeito com MODO_DEMO="true"; fora do modo demo a rota devolve 404.
# CRON_SECRET="uma-string-longa-e-aleatoria"
